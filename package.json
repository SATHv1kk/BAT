{
  "name": "bat-extension",
  "version": "4.0.0",
  "private": true,
  "description": "Browser Automation Tool — a Chrome side-panel agent that reads pages via an accessibility tree and drives them with native tool calls.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/run-tests.mjs",
    "test:live": "node test/run-tests.mjs --only-live",
    "test:all": "node test/run-tests.mjs --live",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.31",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "safe-regex": "^2.1.1"
  }
}
