{
  "manifest_version": 3,
  "name": "BAT",
  "version": "4.0",
  "description": "Browser automation agent in a side panel. Reads pages via an accessibility tree and drives them with native tool calls.",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs", "debugger", "webNavigation"],
  "host_permissions": ["<all_urls>", "https://api.deepseek.com/*"],
  "action": {
    "default_title": "BAT",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "commands": {
    "open-sidepanel": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open BAT side panel"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.deepseek.com;"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/accessibility-tree.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/phantom-cursor.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}